# A Windows or macOS virtualenv copied into a Linux image is both large and
# broken, so it never enters the build context.
.venv/
venv/

__pycache__/
*.py[cod]
*.egg-info/

.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets are supplied by compose, never baked into a layer.
.env
.env.*
!.env.example

Dockerfile
.dockerignore
