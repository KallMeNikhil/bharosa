{
  "expo": {
    "name": "Bharosa Consign",
    "slug": "bharosa-distributor",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "bharosaconsign",
    "userInterfaceStyle": "light",
    "backgroundColor": "#E8EDEE",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "xyz.whynikhil.bharosa.distributor"
    },
    "android": {
      "package": "xyz.whynikhil.bharosa.distributor",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E3A45"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Bharosa Consign uses the camera to read the code on each pack as stock moves."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E3A45"
        }
      ]
    ]
  }
}
