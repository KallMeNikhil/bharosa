ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://bharosa_app:bharosa_app@localhost:5432/bharosa
MIGRATION_DATABASE_URL=postgresql+psycopg://bharosa_owner:bharosa_owner@localhost:5432/bharosa
VERIFICATION_DATABASE_URL=postgresql+psycopg://bharosa_verifier:bharosa_verifier@localhost:5432/bharosa

DIGITAL_LINK_HOST=id.bharosa.example

VERIFICATION_RATE_LIMIT_PER_MINUTE=30
VERIFICATION_RATE_LIMIT_BURST=10
