{
  "expo": {
    "name": "Bharosa",
    "slug": "bharosa-consumer",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "bharosa",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F6F1",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "xyz.whynikhil.bharosa.consumer"
    },
    "android": {
      "package": "xyz.whynikhil.bharosa.consumer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#123D31"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "bharosa.whynikhil.xyz",
              "pathPrefix": "/01"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Bharosa uses the camera to read the code printed on a pack."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Location makes a check more accurate. Bharosa works without it."
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#123D31"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4d0ae2c6-dff3-4c1f-bd02-998f680de7d2"
      }
    }
  }
}
