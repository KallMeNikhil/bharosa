# Address of the Bharosa API as reachable from the device running the app.
#
# On a physical phone "localhost" is the phone, not your computer, so use your
# machine's address on the local network and start uvicorn with
# --host 0.0.0.0 so it accepts connections from outside the loopback.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.3:8000/api/v1
